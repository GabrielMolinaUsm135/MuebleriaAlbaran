              componentClassID="Microsoft.SSISODBCSrc"
              contactInfo="ODBC Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
              description="ODBC Source"
              name="Origen HechoVenta"
              usesDispositions="true"
              version="1">
              <properties>
                <property
                  dataType="System.String"
                  description="The name of the table to be fetched."
                  expressionType="Notify"
                  name="TableName">"dbo"."clientes"</property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
    v.venta_id AS VentaID_BK,
    dv.producto_id AS ProductoSK,
    v.cliente_id AS ClienteSK,
    v.vendedor_id AS EmpleadoSK,
    v.sucursal_id AS SucursalSK,
    CAST(CONVERT(VARCHAR(8), v.fecha, 112) AS INT) AS TiempoSK, -- Convierte la fecha a INT
    v.numero_documento AS NumeroDocumento,
    v.tipo_documento AS TipoDocumento,
    dv.cantidad AS Cantidad,
    dv.precio_unitario AS PrecioUnitario,
    dv.descuento AS Descuento,
    (dv.cantidad * dv.precio_unitario) AS MontoTotal
FROM ventas v 
INNER JOIN detalle_ventas dv ON v.venta_id = dv.venta_id;</property>
