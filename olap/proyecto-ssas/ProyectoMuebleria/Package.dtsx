                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT DISTINCT
    CAST(CONVERT(VARCHAR(8), fecha, 112) AS INT) AS TiempoSK,
    CAST(fecha AS DATE) AS Fecha,
    YEAR(fecha) AS Anio,
    DATEPART(QUARTER, fecha) AS Trimestre,
    MONTH(fecha) AS Mes,
    CAST(DATENAME(MONTH, fecha) AS VARCHAR(20)) AS NombreMes,
    DAY(fecha) AS Dia,
    CAST(DATENAME(WEEKDAY, fecha) AS VARCHAR(20)) AS DiaSemana
FROM ventas;</property>
