              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Origen Hecho de venta"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    v.venta_id                                         AS VentaID_BK,
    dp.ProductoSK,
    dc.ClienteSK,
    de.EmpleadoSK,
    ds.SucursalSK,
    dt.TiempoSK,
    CAST(v.numero_documento AS VARCHAR(50))            AS NumeroDocumento,
    CAST(v.tipo_documento   AS VARCHAR(50))            AS TipoDocumento,
    dv.cantidad                                        AS CantidadProducto,
    CAST(dv.precio_unitario AS DECIMAL(12,2))          AS PrecioUnitarioProducto,
    CAST(ISNULL(dv.descuento, 0) AS DECIMAL(12,2))     AS DescuentoProducto,
    CAST(dv.cantidad * dv.precio_unitario - ISNULL(dv.descuento, 0) AS DECIMAL(12,2)) AS MontoTotalVenta
FROM ventas v
INNER JOIN detalle_ventas dv ON v.venta_id = dv.venta_id
INNER JOIN DW_Albarran.dbo.DimProducto  dp ON dp.ProductoID_BK  = dv.producto_id
INNER JOIN DW_Albarran.dbo.DimCliente   dc ON dc.ClienteID_BK   = v.cliente_id
INNER JOIN DW_Albarran.dbo.DimEmpleado  de ON de.EmpleadoID_BK  = v.vendedor_id
INNER JOIN DW_Albarran.dbo.DimSucursal  ds ON ds.SucursalID_BK  = v.sucursal_id
INNER JOIN DW_Albarran.dbo.DimTiempo   dt ON dt.TiempoSK = CAST(CONVERT(VARCHAR(8), v.fecha, 112) AS INT);</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
