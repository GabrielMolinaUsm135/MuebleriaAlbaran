                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
       CAST(CONVERT(VARCHAR(8), fecha, 112) AS INT)  AS TiempoSK,
       CAST(fecha AS DATE)                           AS Fecha,
       YEAR(fecha)                                   AS Anio,
       DATEPART(QUARTER, fecha)                      AS Trimestre,
       MONTH(fecha)                                  AS NumeroMes,
       CAST(DATENAME(MONTH, fecha)   AS VARCHAR(20)) AS NombreMes,
       DAY(fecha)                                    AS NumeroDia,
       CAST(DATENAME(WEEKDAY, fecha) AS VARCHAR(20)) AS NombreDiaSemana
   FROM ventas
   WHERE fecha IS NOT NULL;</property>
