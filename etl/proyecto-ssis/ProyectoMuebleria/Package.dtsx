                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    e.empleado_id AS EmpleadoID_BK,
    CAST(LTRIM(RTRIM(CONCAT(e.nombre, ' ', e.appaterno, ' ', e.apmaterno))) AS VARCHAR(150)) AS NombreCompletoEmpleado,
    CAST(ISNULL(c.nombre, 'Sin Cargo') AS VARCHAR(100)) AS NombreCargo,
    CAST(e.fecha_contrato AS DATE) AS FechaContratoEmpleado
FROM empleados e
LEFT JOIN cargos c ON e.cargo_id = c.cargo_id;</property>
